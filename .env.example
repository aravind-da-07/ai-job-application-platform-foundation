# =============================================================================
# AI Job Application Platform — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Core ---------------------------------------------------------------
ENVIRONMENT=development          # development | testing | production
APP_NAME="AI Job Application Platform"
APP_VERSION=0.1.0
DEBUG=true

# --- API ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:8501

# --- Supabase ------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=job-platform-files

# Full Postgres connection string from Supabase project settings > Database
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_ECHO=false

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
LOG_TO_SUPABASE=false

# --- Scheduler -----------------------------------------------------------
SCHEDULER_TIMEZONE=UTC
SCHEDULER_JOB_DEFAULTS_MAX_INSTANCES=1
SCHEDULER_MISFIRE_GRACE_TIME_SECONDS=3600

# --- Retry / Timeouts ------------------------------------------------------
DEFAULT_RETRY_COUNT=3
DEFAULT_RETRY_BACKOFF_SECONDS=5
DEFAULT_REQUEST_TIMEOUT_SECONDS=30
BROWSER_NAVIGATION_TIMEOUT_MS=30000

# --- AI --------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL_NAME=claude-sonnet-4-6
AI_MAX_TOKENS=4096
AI_REQUEST_TIMEOUT_SECONDS=60

# --- Browser Automation ------------------------------------------------------
BROWSER_HEADLESS=true
BROWSER_TYPE=chromium
BROWSER_SLOW_MO_MS=0
BROWSER_SESSIONS_DIR=browser_sessions

# --- Dashboard --------------------------------------------------------------
DASHBOARD_PORT=8501
DASHBOARD_REFRESH_SECONDS=30

# --- Application thresholds -----------------------------------------------
MINIMUM_MATCH_SCORE_TO_APPLY=0.70
MANUAL_REVIEW_MATCH_SCORE=0.55
